{
  "name": "snapseek",
  "version": "1.0.1",
  "description": "Modern Electron app for browsing and downloading images from Pinterest, Safebooru, and Pixiv",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "dev": "electron . --dev",
    "dev:ui": "vite",
    "build:ui": "tsc && vite build",
    "build": "npm run build:ui && npm run create-icon && electron-builder",
    "build:installer": "npm run build:ui && node create-icon.js && electron-builder --prepackaged=dist/win-unpacked --win nsis",
    "create-icon": "node create-icon.js"
  },
  "build": {
    "appId": "com.yabosen.snapseek",
    "productName": "SnapSeek",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SnapSeek",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false,
      "license": "LICENSE"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Utility"
    }
  },
  "keywords": [
    "electron",
    "image",
    "downloader",
    "pinterest",
    "safebooru",
    "pixiv"
  ],
  "author": "Yabosen",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1",
    "to-ico": "^1.1.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.26.0",
    "cross-fetch": "^4.0.0",
    "darkreader": "^4.9.118",
    "electron-store": "^8.1.0",
    "sharp": "0.32.6"
  }
}